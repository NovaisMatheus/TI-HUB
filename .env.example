DATABASE_URL=postgresql://hub:hub_dev_only@localhost:5432/ugb_hub?schema=public
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
SEED_PASSWORD=change-this-development-password
HUB_DEMO_DATA=false
HUB_ALLOW_TEST_DATA=false
# Only for the first administrator of a new empty database. Existing accounts are preserved.
BOOTSTRAP_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
ENABLE_CONNECTION_TEST=false

# Google Chat (optional). Tokens are encrypted with an independent 32-byte hex key.
GOOGLE_CHAT_CLIENT_ID=
GOOGLE_CHAT_CLIENT_SECRET=
GOOGLE_CHAT_REDIRECT_URI=http://localhost:5173/api/chat/google/callback
GOOGLE_CHAT_ENCRYPTION_KEY=
