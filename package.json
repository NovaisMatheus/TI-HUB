{
  "name": "ugb-ti-hub",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm extension:package && concurrently -n api,web -c blue,green \"pnpm --filter @hub/api dev\" \"pnpm --filter @hub/web dev\"",
    "build": "pnpm extension:package && pnpm -r build",
    "extension:package": "node scripts/package-extension.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages scripts tests extensions",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "node scripts/database.mjs generate",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "pnpm --filter @hub/api db:seed",
    "db:local": "node scripts/local-postgres.mjs",
    "db:status": "node scripts/database.mjs status",
    "test:smoke": "node scripts/smoke.mjs",
    "test:chain": "node scripts/chain-smoke.mjs",
    "test:interface": "node scripts/interface-smoke.mjs",
    "test:1doc": "node scripts/one-doc-smoke.mjs",
    "test:chat": "node scripts/chat-smoke.mjs",
    "test:users": "node scripts/users-smoke.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "concurrently": "9.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^30.1.2",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4"
  }
}
