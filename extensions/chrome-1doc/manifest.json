{
  "manifest_version": 3,
  "name": "UGB TI Hub · Coletor 1Doc",
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": ["https://*.1doc.com.br/*"],
      "js": ["collector.js", "floating.js"],
      "run_at": "document_idle"
    }
  ],
  "description": "Coleta um documento e seus despachos no 1Doc e abre uma demanda no TI Hub.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Coletar para TI Hub" },
  "background": { "service_worker": "background.js", "type": "module" }
}
